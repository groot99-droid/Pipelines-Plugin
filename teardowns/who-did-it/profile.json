  "era_tags": [
    "\\((?:[Rr]ound \\d+[^)]{0,40})\\)",
    "\\((?:M\\d[a-d]?|R\\d+b?)\\)",
    "\\(V1\\.5\\)|\\(V2\\)",
    "\\(\\d[A-Z]\\)"
  ],
  "decisions": {
    "path": "docs/DECISIONS.md",
    "area": "decisions",
    "row": "^\\|\\s*(A\\d+)\\s*\\|",
    "number": "A(\\d+)",
    "layouts": [
      {
        "from": 1,
        "to": 85,
        "cols": [
          "topic",
          "decision"
        ]
      },
      {
        "from": 86,
        "cols": [
          "decision",
          "open"
        ]
      }
    ],
    "session": "\\b([5-9][A-Z]|[A-Y])\\b(?=[,;)])",
    "reserved": [
      "Reserved for"
    ],
    "open_marker": "Open:",
    "owner_words": [
      "owner"
    ],
    "open_questions": {
      "heading": "Open questions",
      "resolved": "Resolved|Confirmed|Answered"
    }
  },
  "refs": [
    {
      "id": "gdd",
      "pattern": "\\bGDD(?:\\.md`?)?(?:,? section| §)?\\s+(\\d+(?:\\.\\d+)*)",
      "target": "sec:GDD:{1}",
      "strict": true
    },
    {
      "id": "world",
      "pattern": "\\bWORLD(?:\\.md`?)?(?:,? section| §)?\\s+(\\d+(?:\\.\\d+)*)",
      "target": "sec:WORLD:{1}",
      "strict": true
    },
    {
      "id": "ui",
      "pattern": "\\bUI(?:\\.md`?)?(?:,? section| §)?\\s+(\\d+(?:\\.\\d+)*)",
      "target": "sec:UI:{1}",
      "strict": true
    },
    {
      "id": "architecture",
      "pattern": "\\bARCHITECTURE(?:\\.md`?)?(?:,? section| §)?\\s+(\\d+(?:\\.\\d+)*)",
      "target": "sec:ARCHITECTURE:{1}",
      "strict": true
    },
    {
      "id": "assets",
      "pattern": "\\bASSETS(?:\\.md`?)?(?:,? section| §)?\\s+(\\d+(?:\\.\\d+)*)",
      "target": "sec:ASSETS:{1}",
      "strict": true
    },
    {
      "id": "sprites",
      "pattern": "\\bSPRITES(?:\\.md`?)?(?:,? section| §)?\\s+(\\d+(?:\\.\\d+)*)",
      "target": "sec:SPRITES:{1}",
      "strict": true
    },
    {
      "id": "roadmap",
      "pattern": "\\bROADMAP(?:\\.md`?)?(?:,? section| §)?\\s+(\\d+\\.\\d+)",
      "target": "sec:ROADMAP:{1}",
      "strict": true
    },
    {
      "id": "decisions",
      "pattern": "\\bDECISIONS(?:\\.md`?)?\\s+(A\\d{1,3})(?:\\s*(?:to|-|–)\\s*A(?P<to>\\d{1,3}))?",
      "target": "dec:{1}",
      "range": true,
      "strict": true
    },
    {
      "id": "decision-id",
      "pattern": "(?<![\\w/.#-])(A\\d{1,3})(?:\\s*(?:to|-|–)\\s*A(?P<to>\\d{1,3}))?(?![\\w.])",
      "target": "dec:{1}",
      "range": true
    },
    {
      "id": "bible",
      "pattern": "\\bBook\\s+([IVX]+)(?:\\.(\\d+))?\\b",
      "target": "sec:round6/owner-brief:BOOK {1}.{2}"
    },
    {
      "id": "milestone",
      "pattern": "\\b(M\\d[a-d]?|R[789]b?)\\b",
      "target": "milestone:{1}"
    },
    {
      "id": "open-question",
      "pattern": "\\bopen question (\\d+)",
      "target": "oq:{1}"
    }
  ],
  "tables": [
    {
      "id": "c2s",
      "path": "docs/PROTOCOL.md",
      "under": "^Client to server$",
      "kind": "message",
      "area": "backend",
      "key": 0,
      "key_pattern": "([\\w.]+)"
    },
    {
      "id": "s2c",
      "path": "docs/PROTOCOL.md",
      "under": "^Server to client$",
      "kind": "message",
      "area": "backend",
      "key": 0,
      "key_pattern": "([\\w.]+)"
    },
    {
      "id": "errors",
      "path": "docs/PROTOCOL.md",
      "under": "^(Error codes|Join errors)$",
      "kind": "error",
      "area": "backend",
      "key": 0,
      "key_pattern": "([\\w.]+)"
    },
    {
      "id": "milestones",
      "path": "docs/ROADMAP.md",
      "under": "^7\\.1 ",
      "kind": "milestone",
      "area": "future",
      "key": 0,
      "title": 0,
      "key_pattern": "(M\\d+[a-d]?|R\\d+b?|ONUB v2)"
