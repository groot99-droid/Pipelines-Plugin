{
  "mcpServers": {
    "gemini": {
      "command": "npx",
      "args": [
        "-y",
        "gemini-mcp-tool@1.1.4"
      ],
      "env": {
        "GEMINI_MCP_BACKEND": "gemini"
      }
    },
    "brushes": {
      "command": "python",
      "args": [
        "-I",
        "brushes/pipeline/mcp_server.py"
      ]
    }
  }
}
