{
  "mcpServers": {
    "gemini": {
      "command": "npx",
      "args": [
        "-y",
        "gemini-mcp-tool@1.1.4"
      ],
      "env": {
        "GEMINI_MCP_BACKEND": "gemini"
      }
    },
    "brushes": {
      "command": "python",
      "args": [
        "-I",
        "brushes/pipeline/mcp_server.py"
      ]
    },
    "vast": {
      "command": "python",
      "args": [
        "-I",
        "plugins/vast/server/server.py"
      ],
      "env": {
        "VAST_KEYS_FILE": "~/.rosw/keys.env",
        "VAST_WORK_DIR": "studio/pipeline/runs"
      }
    }
  }
}
