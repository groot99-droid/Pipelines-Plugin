# Keys no longer live in the repo. Run
#
#     python docs/setup_keys.py
#
# and paste them into the page it opens: they are saved to ~/.rosw/keys.env
# (or ROSW_KEYS_FILE), which llm.py loads. A value there overrides the shell.
#
# llm.py still reads creative-writing/pipeline/.env if one exists (gitignored);
# `python docs/setup_keys.py --migrate` moves it out of the repo.
GEMINI_API_KEY=your-key-here

# Optional
# GEMINI_MODEL=gemini-3.6-flash
