# Needed only for a live Google Fonts refresh (refresh-google-fonts.py --live,
# driven by the ui-design-catalog-refresh skill). The offline fixture tests in
# catalog/scripts/tests/test_catalog_refresh.py pass without it, and so does
# every gate in verify.py.
#
# refresh-google-fonts.py reads this from the process environment. It does NOT
# load this file, so export it in your shell before running --live. Never paste
# the value into a chat, a command line, or a committed file.
GOOGLE_FONTS_API_KEY=
